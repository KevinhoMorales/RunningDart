rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isValidEnvironment(environment) {
      return environment in ['dev', 'prod'];
    }

    function userDoc(environment) {
      return firestore.get(
        /databases/(default)/documents/environments/$(environment)/users/$(request.auth.uid)
      ).data;
    }

    function isAdmin(environment) {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/environments/$(environment)/users/$(request.auth.uid)
        )
        && userDoc(environment).role == 'admin';
    }

    match /environments/{environment}/users/{userId}/profile.jpg {
      allow read: if isValidEnvironment(environment) && request.auth != null;

      allow write: if isValidEnvironment(environment)
        && request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /environments/{environment}/businesses/{businessId}/cover.jpg {
      allow read: if isValidEnvironment(environment) && request.auth != null;

      allow write: if isValidEnvironment(environment)
        && isAdmin(environment)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isValidEnvironment(environment) && isAdmin(environment);
    }

    match /environments/{environment}/news/{newsId}/cover.jpg {
      allow read: if isValidEnvironment(environment) && request.auth != null;

      allow write: if isValidEnvironment(environment)
        && isAdmin(environment)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isValidEnvironment(environment) && isAdmin(environment);
    }

    match /environments/{environment}/posts/{userId}/{fileName} {
      allow read: if isValidEnvironment(environment) && request.auth != null;

      allow write: if isValidEnvironment(environment)
        && request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isValidEnvironment(environment)
        && request.auth != null
        && (request.auth.uid == userId || isAdmin(environment));
    }

    match /environments/{environment}/payments/{userId}/{paymentId}/{fileName} {
      allow read: if isValidEnvironment(environment)
        && request.auth != null
        && (request.auth.uid == userId || isAdmin(environment));

      allow write: if isValidEnvironment(environment)
        && request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isValidEnvironment(environment)
        && (request.auth.uid == userId || isAdmin(environment));
    }
  }
}
