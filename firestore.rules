rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin';
    }

    function isCoach() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'coach';
    }

    function canManageClubSettings() {
      return isAdmin() || isCoach();
    }

    function isBusinessOperator() {
      return isSignedIn()
        && userDoc().businessId != null
        && userDoc().businessId != '';
    }

    function isActiveMember(userData) {
      return userData.isActive == true
        && userData.role in ['member', 'admin']
        && userData.get('membershipStatus', 'active') == 'active';
    }

    function scannedUserDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function ownerProtectedFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.get('businessId', null)
            == resource.data.get('businessId', null)
        && request.resource.data.get('membershipStatus', 'active')
            == resource.data.get('membershipStatus', 'active')
        && request.resource.data.get('membershipModality', 'community')
            == resource.data.get('membershipModality', 'community')
        && request.resource.data.get('expiresAt', null)
            == resource.data.get('expiresAt', null);
    }

    match /users/{userId} {
      allow read: if isOwner(userId)
        || isAdmin()
        || (isBusinessOperator() && isActiveMember(resource.data));

      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.isActive == true
        && request.resource.data.membershipStatus in ['pending', 'active'];

      allow update: if (isAdmin()
          && (userId != request.auth.uid
              || request.resource.data.role == resource.data.role))
        || (isOwner(userId) && ownerProtectedFieldsUnchanged());

      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if isSignedIn() && resource.data.isPublished == true;
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isAdmin()
        || (isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending');

      allow update, delete: if isAdmin();
    }

    match /visits/{visitId} {
      allow read: if isAdmin()
        || (isBusinessOperator()
          && resource.data.businessId == userDoc().businessId);

      allow create: if isBusinessOperator()
        && request.resource.data.businessId == userDoc().businessId
        && request.resource.data.scannedByUserId == request.auth.uid
        && request.resource.data.userId != request.auth.uid
        && scannedUserDoc(request.resource.data.userId).get('businessId', '')
            != userDoc().businessId
        && request.resource.data.keys().hasAll([
          'userId',
          'businessId',
          'visitedAt',
          'memberDisplayName',
          'memberQrCode',
          'scannedByUserId',
          'validationResult',
        ]);

      allow update, delete: if false;
    }

    match /club_settings/{docId} {
      allow read: if isSignedIn();
      allow create, update: if canManageClubSettings();
      allow delete: if isAdmin();
    }
  }
}
