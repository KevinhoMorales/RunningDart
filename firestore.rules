rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidEnvironment(environment) {
      return environment in ['dev', 'prod'];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(environment) {
      return get(/databases/$(database)/documents/environments/$(environment)/users/$(request.auth.uid)).data;
    }

    function isAdmin(environment) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/environments/$(environment)/users/$(request.auth.uid))
        && userDoc(environment).role == 'admin';
    }

    function isCoach(environment) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/environments/$(environment)/users/$(request.auth.uid))
        && userDoc(environment).role == 'coach';
    }

    function canManageClubSettings(environment) {
      return isAdmin(environment) || isCoach(environment);
    }

    function isBusinessOperator(environment) {
      return isSignedIn()
        && userDoc(environment).businessId != null
        && userDoc(environment).businessId != '';
    }

    function isActiveMember(userData) {
      return userData.isActive == true
        && userData.role in ['member', 'admin']
        && userData.get('membershipStatus', 'active') == 'active';
    }

    function scannedUserDoc(environment, userId) {
      return get(/databases/$(database)/documents/environments/$(environment)/users/$(userId)).data;
    }

    function ownerProtectedFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.get('businessId', null)
            == resource.data.get('businessId', null)
        && request.resource.data.get('membershipStatus', 'active')
            == resource.data.get('membershipStatus', 'active')
        && request.resource.data.get('membershipModality', 'community')
            == resource.data.get('membershipModality', 'community')
        && request.resource.data.get('expiresAt', null)
            == resource.data.get('expiresAt', null);
    }

    match /environments/{environment}/users/{userId} {
      allow read: if isValidEnvironment(environment)
        && (isOwner(userId)
          || isAdmin(environment)
          || (isBusinessOperator(environment) && isActiveMember(resource.data)));

      allow create: if isValidEnvironment(environment)
        && isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.isActive == true
        && request.resource.data.membershipStatus in ['pending', 'active'];

      allow update: if isValidEnvironment(environment)
        && ((isAdmin(environment)
            && (userId != request.auth.uid
                || request.resource.data.role == resource.data.role))
          || (isOwner(userId) && ownerProtectedFieldsUnchanged()));

      allow delete: if isValidEnvironment(environment)
        && (isOwner(userId) || isAdmin(environment));
    }

    match /environments/{environment}/businesses/{businessId} {
      allow read: if isValidEnvironment(environment) && isSignedIn();
      allow create, update: if isValidEnvironment(environment) && isAdmin(environment);
      allow delete: if isValidEnvironment(environment) && isAdmin(environment);
    }

    match /environments/{environment}/news/{newsId} {
      allow read: if isValidEnvironment(environment)
        && isSignedIn()
        && resource.data.isPublished == true;
      allow read: if isValidEnvironment(environment) && isAdmin(environment);
      allow create, update: if isValidEnvironment(environment) && isAdmin(environment);
      allow delete: if isValidEnvironment(environment) && isAdmin(environment);
    }

    match /environments/{environment}/payments/{paymentId} {
      allow read: if isValidEnvironment(environment)
        && (isAdmin(environment)
          || (isSignedIn() && resource.data.userId == request.auth.uid));

      allow create: if isValidEnvironment(environment)
        && (isAdmin(environment)
          || (isSignedIn()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'pending'));

      allow update, delete: if isValidEnvironment(environment)
        && (isAdmin(environment)
          || (isSignedIn() && resource.data.userId == request.auth.uid));
    }

    match /environments/{environment}/visits/{visitId} {
      allow read: if isValidEnvironment(environment)
        && (isAdmin(environment)
          || (isBusinessOperator(environment)
            && resource.data.businessId == userDoc(environment).businessId));

      allow create: if isValidEnvironment(environment)
        && isBusinessOperator(environment)
        && request.resource.data.businessId == userDoc(environment).businessId
        && request.resource.data.scannedByUserId == request.auth.uid
        && request.resource.data.userId != request.auth.uid
        && scannedUserDoc(environment, request.resource.data.userId).get('businessId', '')
            != userDoc(environment).businessId
        && request.resource.data.keys().hasAll([
          'userId',
          'businessId',
          'visitedAt',
          'memberDisplayName',
          'memberQrCode',
          'scannedByUserId',
          'validationResult',
        ]);

      allow update, delete: if false;
    }

    match /environments/{environment}/club_settings/{docId} {
      allow read: if isValidEnvironment(environment) && isSignedIn();
      allow create, update: if isValidEnvironment(environment)
        && canManageClubSettings(environment);
      allow delete: if isValidEnvironment(environment) && isAdmin(environment);
    }
  }
}
