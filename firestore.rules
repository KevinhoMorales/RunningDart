rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidEnvironment(environment) {
      return environment in ['dev', 'prod'];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(environment) {
      return get(/databases/$(database)/documents/environments/$(environment)/users/$(request.auth.uid)).data;
    }

    function isAdmin(environment) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/environments/$(environment)/users/$(request.auth.uid))
        && userDoc(environment).role == 'admin';
    }

    function isCoach(environment) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/environments/$(environment)/users/$(request.auth.uid))
        && userDoc(environment).role == 'coach';
    }

    function canManageClubSettings(environment) {
      return isAdmin(environment) || isCoach(environment);
    }

    function isBusinessOperator(environment) {
      return isSignedIn()
        && userDoc(environment).businessId != null
        && userDoc(environment).businessId != '';
    }

    function isActiveMember(userData) {
      return userData.isActive == true
        && userData.role in ['member', 'admin']
        && userData.get('membershipStatus', 'active') == 'active';
    }

    function scannedUserDoc(environment, userId) {
      return get(/databases/$(database)/documents/environments/$(environment)/users/$(userId)).data;
    }

    // Espejo de UserModel.hasMembershipPrivileges: al administrador no le caduca
    // la membresía; al resto sí. Sin esto la vigencia se comprobaría solo en el
    // cliente y un operador podría registrar visitas aprobadas a mano.
    function hasMembershipPrivileges(userData) {
      return userData.isActive == true
        && (userData.role == 'admin'
          || (userData.role == 'member'
            && userData.get('membershipStatus', 'active') == 'active'
            && (userData.get('expiresAt', null) == null
              || request.time < userData.expiresAt)));
    }

    function postAuthorId(environment, postId) {
      return get(/databases/$(database)/documents/environments/$(environment)/posts/$(postId)).data.authorId;
    }

    function ownerProtectedFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.get('businessId', null)
            == resource.data.get('businessId', null)
        && request.resource.data.get('membershipStatus', 'active')
            == resource.data.get('membershipStatus', 'active')
        && request.resource.data.get('membershipModality', 'community')
            == resource.data.get('membershipModality', 'community')
        && request.resource.data.get('expiresAt', null)
            == resource.data.get('expiresAt', null)
        && request.resource.data.get('activatedAt', null)
            == resource.data.get('activatedAt', null)
        && request.resource.data.get('internalNotes', null)
            == resource.data.get('internalNotes', null);
    }

    function postHiddenDetailFields() {
      return ['hiddenReason', 'hiddenNote', 'hiddenAt', 'hiddenBy'];
    }

    function postModerationFields() {
      return postHiddenDetailFields().concat(['isHidden']);
    }

    // Los escribe el servidor: `authorId` y `createdAt` al publicar, y el resto
    // la Cloud Function de likes. El autor no debe poder tocarlos al editar.
    function postServerFields() {
      return ['authorId', 'createdAt', 'likesCount', 'recentLikes'];
    }

    function usernameCooldownOk() {
      return request.resource.data.get('username', null)
            == resource.data.get('username', null)
        || resource.data.get('usernameUpdatedAt', null) == null
        || request.time > resource.data.usernameUpdatedAt + duration.value(30, 'd');
    }

    match /environments/{environment}/users/{userId} {
      allow read: if isValidEnvironment(environment)
        && (isOwner(userId)
          || isAdmin(environment)
          || (isBusinessOperator(environment) && isActiveMember(resource.data)));

      allow create: if isValidEnvironment(environment)
        && isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.isActive == true
        && request.resource.data.membershipStatus in ['pending', 'active'];

      allow update: if isValidEnvironment(environment)
        && ((isAdmin(environment)
            && (userId != request.auth.uid
                || request.resource.data.role == resource.data.role))
          || (isOwner(userId)
            && ownerProtectedFieldsUnchanged()
            && usernameCooldownOk()));

      allow delete: if isValidEnvironment(environment)
        && (isOwner(userId) || isAdmin(environment));
    }

    match /environments/{environment}/businesses/{businessId} {
      allow read: if isValidEnvironment(environment) && isSignedIn();
      allow create, update: if isValidEnvironment(environment) && isAdmin(environment);
      allow delete: if isValidEnvironment(environment) && isAdmin(environment);
    }

    match /environments/{environment}/news/{newsId} {
      allow read: if isValidEnvironment(environment)
        && isSignedIn()
        && resource.data.isPublished == true;
      allow read: if isValidEnvironment(environment) && isAdmin(environment);
      allow create, update: if isValidEnvironment(environment) && isAdmin(environment);
      allow delete: if isValidEnvironment(environment) && isAdmin(environment);
    }

    match /environments/{environment}/payments/{paymentId} {
      allow read: if isValidEnvironment(environment)
        && (isAdmin(environment)
          || (isSignedIn() && resource.data.userId == request.auth.uid));

      allow create: if isValidEnvironment(environment)
        && (isAdmin(environment)
          || (isSignedIn()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'pending'));

      // Aprobar es cosa del administrador. Al dueño solo le queda reemplazar el
      // comprobante mientras su pago siga sin revisar.
      allow update: if isValidEnvironment(environment)
        && (isAdmin(environment)
          || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['receiptUrl'])));

      // Solo el administrador borra: el historial de pagos es la auditoría de
      // las membresías.
      allow delete: if isValidEnvironment(environment) && isAdmin(environment);
    }

    match /environments/{environment}/visits/{visitId} {
      allow read: if isValidEnvironment(environment)
        && (isAdmin(environment)
          || (isBusinessOperator(environment)
            && resource.data.businessId == userDoc(environment).businessId));

      allow create: if isValidEnvironment(environment)
        && isBusinessOperator(environment)
        && request.resource.data.businessId == userDoc(environment).businessId
        && request.resource.data.scannedByUserId == request.auth.uid
        && request.resource.data.userId != request.auth.uid
        && scannedUserDoc(environment, request.resource.data.userId).get('businessId', '')
            != userDoc(environment).businessId
        // Rechazar se puede siempre (queda como auditoría del intento), pero
        // aprobar exige que el socio escaneado pueda recibir beneficios de verdad.
        && (request.resource.data.validationResult != 'approved'
          || hasMembershipPrivileges(
            scannedUserDoc(environment, request.resource.data.userId)))
        && request.resource.data.keys().hasAll([
          'userId',
          'businessId',
          'visitedAt',
          'memberDisplayName',
          'memberQrCode',
          'scannedByUserId',
          'validationResult',
        ]);

      allow update, delete: if false;
    }

    match /environments/{environment}/club_settings/{docId} {
      allow read: if isValidEnvironment(environment) && isSignedIn();
      allow create, update: if isValidEnvironment(environment)
        && canManageClubSettings(environment);
      allow delete: if isValidEnvironment(environment) && isAdmin(environment);
    }

    match /environments/{environment}/public_profiles/{userId} {
      allow read: if isValidEnvironment(environment) && isSignedIn();
      allow create, update: if isValidEnvironment(environment)
        && (isOwner(userId) || isAdmin(environment));
      allow delete: if isValidEnvironment(environment)
        && (isOwner(userId) || isAdmin(environment));
    }

    match /environments/{environment}/usernames/{username} {
      allow read: if isValidEnvironment(environment) && isSignedIn();
      allow create: if isValidEnvironment(environment)
        && isSignedIn()
        && (request.resource.data.userId == request.auth.uid
          || isAdmin(environment));
      allow update: if false;
      allow delete: if isValidEnvironment(environment)
        && isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin(environment));
    }

    match /environments/{environment}/posts/{postId} {
      // Ocultar tiene que valer también para lectura, o cualquiera con el SDK
      // sigue viendo lo moderado.
      //
      // Va con acceso directo al campo, no con `data.get('isHidden', false)`:
      // Firestore exige que un `list` sea demostrablemente seguro solo a partir
      // de la consulta, y el valor por defecto vuelve la condición opaca para
      // ese análisis, con lo que una consulta sin filtro pasaría igual.
      allow read: if isValidEnvironment(environment)
        && isSignedIn()
        && (resource.data.isHidden == false
          || resource.data.authorId == request.auth.uid
          || isAdmin(environment));

      // `isHidden` es obligatorio justamente porque la regla de lectura lo
      // exige: un documento sin el campo no lo podría leer nadie.
      allow create: if isValidEnvironment(environment)
        && isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.isHidden == false
        && !request.resource.data.keys().hasAny(postHiddenDetailFields());

      // El administrador solo puede ocultar y volver a mostrar; el autor puede
      // editar lo suyo pero no la moderación.
      allow update: if isValidEnvironment(environment)
        && ((isAdmin(environment)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(postModerationFields()))
          || (isSignedIn()
            && resource.data.authorId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(postModerationFields())
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(postServerFields())));

      // Borrar es solo del autor: al administrador le toca ocultar.
      allow delete: if isValidEnvironment(environment)
        && isSignedIn()
        && resource.data.authorId == request.auth.uid;
    }

    match /environments/{environment}/follows/{followId} {
      allow read: if isValidEnvironment(environment) && isSignedIn();
      allow create: if isValidEnvironment(environment)
        && isSignedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if isValidEnvironment(environment)
        && isSignedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /environments/{environment}/post_likes/{likeId} {
      allow read: if isValidEnvironment(environment) && isSignedIn();
      // `postAuthorId` va desnormalizado y la Cloud Function de borrado de
      // cuenta se fía de él, así que tiene que coincidir con el autor real.
      allow create: if isValidEnvironment(environment)
        && isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.postAuthorId
            == postAuthorId(environment, request.resource.data.postId);
      allow update: if false;
      allow delete: if isValidEnvironment(environment)
        && isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /environments/{environment}/blocks/{blockId} {
      allow read: if isValidEnvironment(environment)
        && isSignedIn()
        && resource.data.blockerId == request.auth.uid;
      allow create: if isValidEnvironment(environment)
        && isSignedIn()
        && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isValidEnvironment(environment)
        && isSignedIn()
        && resource.data.blockerId == request.auth.uid;
    }

    match /environments/{environment}/post_reports/{reportId} {
      allow read: if isValidEnvironment(environment) && isAdmin(environment);
      allow create: if isValidEnvironment(environment)
        && isSignedIn()
        && request.resource.data.reportedByUserId == request.auth.uid;
      allow update, delete: if isValidEnvironment(environment)
        && isAdmin(environment);
    }
  }
}
